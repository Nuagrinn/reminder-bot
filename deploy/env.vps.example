# Copy to .env on the VPS and fill secrets manually.

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_CONCURRENT_UPDATES=4
TELEGRAM_CONNECTION_POOL_SIZE=16

DB_PATH=/opt/reminder-bot/data/reminder.sqlite3
REMINDER_TICK_SECONDS=60
TIMEZONE=Europe/Moscow
DEFAULT_DAY_REMINDER_TIME=09:00
DEFAULT_EVENING_REMINDER_TIME=20:00
DEFAULT_DAY_BEFORE_REMINDER_TIME=20:00
DEFAULT_TIMED_EVENT_OFFSET_MINUTES=120
DEFAULT_EXACT_TIME_TODAY_OFFSETS_MINUTES=60,15
DEFAULT_EXACT_TIME_FUTURE_OFFSETS_MINUTES=60,15
DEFAULT_BIRTHDAY_OFFSETS_MINUTES=1440,0
DEFAULT_DEADLINE_DAYS_BEFORE=3,1
DEFAULT_ANNUAL_DAYS_BEFORE=7,1
MATERIALIZE_DAYS=180
DAILY_AGENDA_ENABLED=true
DAILY_AGENDA_TIME=07:00
DAILY_AGENDA_LIMIT=50

PARSER_PROVIDER=claude_cli
PARSER_MAX_CONCURRENT=2
CLAUDE_BIN=claude
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_TIMEOUT_SECONDS=120
CLAUDE_MAX_BUDGET_USD=0.12
CLAUDE_SYSTEM_PROMPT_MODE=replace
ALLOW_PAID_API=false

STT_PROVIDER=whisper_cpp
VOICE_DIR=/opt/reminder-bot/data/voice
STT_LANGUAGE=ru
STT_PROMPT=напоминание, дата, время, день рождения, карта, отчет
STT_TIMEOUT_SECONDS=180
STT_MAX_CONCURRENT=1
STT_WHISPER_CPP_BIN=/opt/assistant-shared/whisper.cpp/bin/whisper-cli
STT_WHISPER_CPP_MODEL=/opt/assistant-shared/whisper.cpp/models/ggml-medium.bin
FFMPEG_BIN=ffmpeg
