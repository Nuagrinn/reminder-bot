[Unit]
Description=Personal Telegram reminder bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reminder-bot
Group=reminder-bot
WorkingDirectory=/opt/reminder-bot
Environment=HOME=/home/reminder-bot
Environment=TZ=Europe/Moscow
EnvironmentFile=/opt/reminder-bot/.env
ExecStart=/opt/reminder-bot/.venv/bin/python -m app.telegram_bot
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/reminder-bot /home/reminder-bot /opt/assistant-shared

[Install]
WantedBy=multi-user.target
